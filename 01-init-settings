#!/bin/sh
# =========================================
# ImmortalWrt 初始化脚本 (apk 版本适配)
# =========================================

# --- 设置 LAN IP ---
uci set network.lan.ipaddr='192.168.5.1/24'
uci commit network

# --- 设置系统语言为简体中文 ---
uci set luci.main.lang='zh_cn'
uci commit luci

# --- 设置时区为中国标准时间 ---
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].timezone='CST-8'
uci commit system

# --- 启用 SSH ---
uci set dropbear.@dropbear[0].enable='1'
uci commit dropbear
/etc/init.d/dropbear restart

# --- 关闭 IPv6（可选，如果你希望不启用 IPv6） ---
uci set network.lan.ip6assign='0'
uci commit network

# --- 设置国内 NTP 服务器 ---
uci set system.ntp.server='ntp1.aliyun.com ntp2.aliyun.com ntp3.aliyun.com'
uci commit system
/etc/init.d/sysntpd restart

exit 0
